/* ============================================================
   RAG-TUI Design System

   Design principles:
     - Persistent context: users always know their current state
     - Information density: show more with less chrome
     - Color semantics: green=good, amber=caution, red=bad
     - Border hierarchy: tall=interactive, solid=structural
     - Spacing rhythm: 1-unit margins, 1-2 unit padding
   ============================================================ */


/* ── Screen ──────────────────────────────────────────────── */
Screen {
    background: $background;
}


/* ── Header ──────────────────────────────────────────────── */
Header {
    background: $primary-darken-2;
    color: $text;
    height: 1;
    dock: top;
}


/* ── Strategy bar ────────────────────────────────────────── */
#strategy-bar {
    dock: top;
    height: 3;
    padding: 0 2;
    background: $surface-darken-1;
    border-bottom: solid $primary-darken-1;
    align: center middle;
}

#strategy-bar Label {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}

#strategy-bar Select {
    width: 24;
}

#strategy-bar Input {
    width: 1fr;
    margin: 0 1;
}

#strategy-bar Button {
    min-width: 8;
    width: 8;
}


/* ── Status strip ─────────────────────────────────────────
   Always-visible bar showing active config + eval mode.
   One glance = full picture. Never hunt through tabs.
   ──────────────────────────────────────────────────────── */
#status-strip {
    dock: top;
    height: 1;
    background: $primary-darken-2;
    color: $text-muted;
    padding: 0 2;
}


/* ── Tabs ────────────────────────────────────────────────── */
TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 1 2;
}


/* ── Common ──────────────────────────────────────────────── */
.tab-intro {
    color: $text-muted;
    height: auto;
    padding: 0 0 1 0;
}

.section-title {
    color: $accent;
    text-style: bold;
    height: auto;
    padding: 0 0 1 0;
}

.button-row {
    height: auto;
    margin-top: 1;
    align: left middle;
}

.button-row Button {
    margin-right: 1;
}

Button:focus {
    border: tall $accent;
}


/* ── Input tab ───────────────────────────────────────────── */
#text-input {
    height: 1fr;
    min-height: 10;
    border: tall $primary-darken-1;
    margin-bottom: 1;
}

#text-input:focus {
    border: tall $accent;
}


/* ── Chunks tab ──────────────────────────────────────────── */
#chunk-summary {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    background: $surface-darken-1;
    border-left: solid $accent;
    color: $text;
    text-style: bold;
}

#chunk-list {
    height: 1fr;
}


/* ── Chunk Cards ─────────────────────────────────────────── */
ChunkCard {
    height: auto;
    max-height: 13;
    margin: 0 0 1 0;
    padding: 0;
    border: tall $primary-darken-1;
    background: $surface;
}

ChunkCard .chunk-header {
    height: 1;
    padding: 0 1;
    background: $surface-darken-1;
    color: $text;
    text-style: bold;
    border-bottom: solid $primary-darken-2;
    width: 1fr;
}

ChunkCard .chunk-header-row {
    height: 1;
    margin: 0;
    padding: 0;
    width: 100%;
}

ChunkCard .copy-btn {
    width: 6;
    min-width: 6;
    height: 1;
    background: $surface-darken-1;
    border: none;
    color: $text-muted;
}

ChunkCard .copy-btn:hover {
    color: $text;
    background: $primary-darken-1;
}

ChunkCard .chunk-scroll {
    height: auto;
    max-height: 8;
    overflow-y: auto;
    padding: 0 1;
}

ChunkCard .chunk-content {
    height: auto;
    color: $text;
}

ChunkCard .chunk-meta {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: $surface-darken-1;
    border-top: solid $primary-darken-2;
}

ChunkCard .overlap-indicator {
    color: #f59e0b;
    text-style: bold;
}

ChunkList .empty-state {
    color: $text-muted;
    text-align: center;
    padding: 4;
}


/* ── Parameter panel ─────────────────────────────────────── */
ParameterPanel {
    height: auto;
    background: $surface-darken-1;
    border: solid $primary-darken-1;
    padding: 0 1 1 1;
    margin: 0 0 1 0;
}

ParameterPanel .panel-title {
    color: $accent;
    text-style: bold;
    height: auto;
    padding: 1 0 1 0;
}

ParameterPanel .status-row {
    height: auto;
    padding-top: 1;
    border-top: solid $primary-darken-2;
}

ParameterPanel .chunk-status {
    color: $success;
    text-style: bold;
}

ParameterControl {
    height: auto;
    padding: 0;
    margin: 0 0 1 0;
}

ParameterControl .param-row {
    height: 1;
    align: center middle;
}

ParameterControl .param-label {
    width: 14;
    color: $text-muted;
}

ParameterControl .param-btn {
    min-width: 3;
    width: 3;
    margin: 0;
}

ParameterControl .param-input {
    width: 8;
    margin: 0 1;
}

ParameterControl .param-bar {
    width: 1fr;
    margin: 0 1;
}

ParameterControl .param-suffix {
    width: 8;
    color: $text-muted;
}


/* ── Search tab ──────────────────────────────────────────── */
.query-section {
    height: auto;
    border: tall $primary-darken-1;
    padding: 1;
    margin-bottom: 1;
    background: $surface;
}

.query-row {
    height: auto;
    align: center middle;
}

.query-row Input {
    width: 1fr;
}

.query-row Input:focus {
    border: tall $accent;
}

.query-row Button {
    margin-left: 1;
    min-width: 10;
}

.results-section {
    height: 1fr;
    overflow-y: auto;
}

ResultCard {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 0 1 0;
    border: tall $primary-darken-1;
    background: $surface;
}

ResultCard .result-header {
    height: 1;
    padding: 0 1;
    background: $surface-darken-1;
    border-bottom: solid $primary-darken-2;
}

ResultCard .result-content {
    padding: 1 1 0 1;
    color: $text;
    height: auto;
}

SimilarityBar {
    height: 1;
    padding: 0 1;
}

.empty-results {
    color: $text-muted;
    text-align: center;
    padding: 4;
}


/* ── Batch tab ───────────────────────────────────────────── */
#batch-queries {
    height: 8;
    border: tall $primary-darken-1;
    margin-bottom: 1;
}

#batch-queries:focus {
    border: tall $accent;
}

#judge-tip {
    color: $text-muted;
    height: auto;
    padding: 0;
    margin: 0 0 1 0;
}

.batch-results {
    height: auto;
    min-height: 6;
    padding: 1;
    border: tall $primary-darken-1;
    margin-top: 1;
    color: $text;
    background: $surface;
}


/* ── Optimize tab ────────────────────────────────────────── */
OptimizePanel {
    height: 1fr;
    padding: 1;
}

OptimizePanel .opt-section {
    text-style: bold;
    color: $accent;
    height: auto;
    padding: 0 0 0 1;
    margin-top: 1;
}

OptimizePanel .opt-row {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    align: center middle;
}

OptimizePanel .opt-label {
    width: 16;
    color: $text-muted;
}

OptimizePanel .opt-input {
    width: 1fr;
}

OptimizePanel .opt-btn-row {
    height: auto;
    padding: 0 1;
    margin: 1 0;
    align: left middle;
}

OptimizePanel .opt-btn-row Button {
    margin-right: 1;
}

OptimizePanel .opt-log {
    height: 8;
    border: tall $primary-darken-1;
    margin: 0 1;
}

OptimizePanel .opt-recommendation {
    color: $success;
    text-style: bold;
    padding: 0 1;
    margin: 0 1;
    border-left: solid $success;
    height: auto;
    min-height: 1;
}

OptimizePanel .opt-results {
    height: 1fr;
    border: tall $primary-darken-1;
    margin: 0 1;
    padding: 0;
}

OptimizePanel .opt-result-row {
    height: 2;
    padding: 0 1;
    border-bottom: solid $primary-darken-2;
    align: center middle;
}

OptimizePanel .opt-result-text {
    width: 1fr;
    content-align: left middle;
}

OptimizePanel .opt-apply-btn {
    width: 8;
    min-width: 8;
    height: 1;
}

OptimizePanel .opt-empty {
    color: $text-muted;
    text-align: center;
    padding: 4;
}

OptimizePanel TextArea {
    height: 5;
    border: tall $primary-darken-1;
    margin-bottom: 0;
}

OptimizePanel TextArea:focus {
    border: tall $accent;
}

OptimizePanel #opt-strat-row {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

OptimizePanel #opt-strat-row Button {
    margin-right: 1;
    min-width: 12;
    margin-bottom: 0;
}


/* ── Settings tab ────────────────────────────────────────── */
.recommendations-panel {
    height: auto;
    padding: 1;
    border-left: solid $success;
    background: $surface;
    margin: 0 0 1 0;
    color: $text;
}

#preset-select {
    width: 40;
    margin: 0 0 1 0;
}

.export-preview {
    height: auto;
    padding: 1;
    background: $surface-darken-1;
    margin: 1 0;
    border: tall $primary-darken-1;
    color: $text;
}

#custom-code {
    height: 10;
    border: tall $primary-darken-1;
    margin: 0 0 1 0;
}

#custom-code:focus {
    border: tall $accent;
}

#custom-cleaner-code {
    height: 8;
    border: tall $primary-darken-1;
    margin: 0 0 1 0;
}

#custom-cleaner-code:focus {
    border: tall $accent;
}


/* ── Chat tab ────────────────────────────────────────────── */
#chat-tab {
    height: 1fr;
    padding: 0 2;
}

#chat-log {
    height: 1fr;
    border: tall $primary-darken-1;
    background: $surface;
    margin-bottom: 1;
}

#chat-input-row {
    height: 3;
    align: center middle;
}

#chat-input {
    width: 1fr;
    height: 3;
    border: tall $primary-darken-1;
}

#chat-input:focus {
    border: tall $accent;
}

#chat-send-btn {
    width: 12;
    height: 3;
    margin-left: 1;
}

.live-response {
    height: auto;
    min-height: 3;
    max-height: 12;
    border-left: solid $accent;
    background: $surface-darken-1;
    padding: 1;
    margin-bottom: 1;
    display: none;
}


/* ── Footer ──────────────────────────────────────────────── */
Footer {
    background: $surface-darken-1;
    color: $text-muted;
    height: 1;
}


/* ── Global interactive focus ────────────────────────────── */
Input:focus {
    border: tall $accent;
}

TextArea:focus {
    border: tall $accent;
}

Select:focus {
    border: tall $accent;
}
